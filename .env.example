# Application Environment
APP_ENV=development
APP_PORT=8088
APP_BASE_URL=http://localhost:8088

# Embedded SQLite Database
DATABASE_PATH=laboratory.db

# Session & Security
SESSION_SECRET=your-secret-key-change-this-in-production
CSRF_SECRET=your-csrf-secret-change-this-in-production

# Default Admin User
ADMIN_NAME=Coordenação CETEP
ADMIN_EMAIL=admin@cetep.local
ADMIN_PASSWORD=Admin@123

# Email / SMTP (Mailpit for local testing: SMTP on 1026, Web UI on http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cetep.local
